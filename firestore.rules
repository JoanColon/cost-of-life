rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspace) {
      return isSignedIn()
        && request.auth.uid in workspace.memberIds;
    }

    function isWorkspaceOwner(workspace) {
      return isWorkspaceMember(workspace)
        && workspace.members[request.auth.uid].role == 'owner';
    }

    function isWorkspaceMemberById(workspaceId) {
      return isWorkspaceMember(
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
      );
    }

    function workspaceAfterWrite(workspaceId) {
      return getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isWorkspaceOwner(request.resource.data);
      allow read: if isWorkspaceMember(resource.data);
      allow update, delete: if isWorkspaceOwner(resource.data);

      match /financialYears/{year} {
        allow read: if isWorkspaceMemberById(workspaceId);
        allow write: if false;
      }

      // During development, workspace members can collaborate on the model
      // and operational data below their workspace. Administrative access to
      // the workspace document itself remains owner-only above.
      match /{collectionId}/{document=**} {
        allow read, write: if (
          collectionId == 'modelAssets'
          || collectionId == 'modelLiabilities'
          || collectionId == 'modelIncome'
          || collectionId == 'modelExpenses'
          || collectionId == 'modelConfig'
          || collectionId == 'expenseTracking'
        )
          && isWorkspaceMemberById(workspaceId);
      }
    }

    match /workspaceInvites/{inviteId} {
      allow create: if isWorkspaceOwner(
        workspaceAfterWrite(request.resource.data.workspaceId)
      );
      allow read, update, delete: if isWorkspaceOwner(
        get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
