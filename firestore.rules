rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceMember(workspace) {
      return isSignedIn()
        && request.auth.uid in workspace.memberIds;
    }

    function isWorkspaceActive(workspace) {
      return !('deletionPendingAt' in workspace);
    }

    function isWorkspaceMemberById(workspaceId) {
      return isWorkspaceMember(
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
      );
    }

    match /workspaces/{workspaceId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.members[request.auth.uid].role == 'owner'
        && isWorkspaceActive(request.resource.data);
      allow read: if isWorkspaceMember(resource.data);
      allow update: if isWorkspaceMember(resource.data)
        && isWorkspaceActive(resource.data)
        && isWorkspaceActive(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['memberIds', 'members']);
      allow delete: if false;

      match /financialYears/{year} {
        allow read: if isWorkspaceMemberById(workspaceId);
        allow write: if false;
      }

      match /achievements/{milestoneId} {
        allow read: if isWorkspaceMemberById(workspaceId);
        allow create: if isWorkspaceMemberById(workspaceId)
          && isWorkspaceActive(
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
          )
          && request.resource.data.keys().hasOnly([
            'milestoneId',
            'family',
            'achievedAt',
            'achievedValue'
          ])
          && request.resource.data.milestoneId == milestoneId
          && request.resource.data.achievedAt == request.time
          && request.resource.data.achievedValue is number
          && request.resource.data.family in ['safety', 'netWorth', 'debt', 'freedom'];
        allow update, delete: if false;
      }

      match /modelConfig/{configId} {
        allow read: if isWorkspaceMemberById(workspaceId);
        allow write: if isWorkspaceMemberById(workspaceId)
          && isWorkspaceActive(
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
          )
          && (
            configId != 'whatIf'
            || (
              request.resource.data.keys().hasOnly([
                'schemaVersion',
                'discretionaryReductionPercent',
                'expectedAnnualReturnPercent',
                'selectedLiabilityId',
                'strategy',
                'updatedAt',
                'updatedBy'
              ])
              && request.resource.data.schemaVersion == 1
              && request.resource.data.discretionaryReductionPercent is number
              && request.resource.data.discretionaryReductionPercent >= 0
              && request.resource.data.discretionaryReductionPercent <= 100
              && request.resource.data.expectedAnnualReturnPercent is number
              && request.resource.data.expectedAnnualReturnPercent >= 0
              && request.resource.data.expectedAnnualReturnPercent <= 100
              && (
                request.resource.data.selectedLiabilityId == null
                || request.resource.data.selectedLiabilityId is string
              )
              && request.resource.data.strategy.keys().hasOnly(['cash', 'invest', 'debt'])
              && request.resource.data.strategy.cash is number
              && request.resource.data.strategy.invest is number
              && request.resource.data.strategy.debt is number
              && request.resource.data.strategy.cash >= 0
              && request.resource.data.strategy.invest >= 0
              && request.resource.data.strategy.debt >= 0
              && request.resource.data.strategy.cash
                + request.resource.data.strategy.invest
                + request.resource.data.strategy.debt == 100
              && request.resource.data.updatedAt == request.time
              && request.resource.data.updatedBy == request.auth.uid
            )
          );
      }

      // Model items are read here but mutated through the callable function so
      // each item and its financial-year projection commit atomically.
      match /{collectionId}/{document=**} {
        allow read: if (
          collectionId == 'modelAssets'
          || collectionId == 'modelLiabilities'
          || collectionId == 'modelIncome'
          || collectionId == 'modelExpenses'
          || collectionId == 'expenseTracking'
        )
          && isWorkspaceMemberById(workspaceId);
        allow write: if (
          collectionId == 'expenseTracking'
        )
          && isWorkspaceMemberById(workspaceId)
          && isWorkspaceActive(
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
          );
      }
    }

    match /workspaceInvites/{inviteId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
